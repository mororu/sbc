# Copy to .env for local development:  cp .env.example .env
# Read only by src/lib/server/env.ts.

# SQLite file; created on first start, migrations are applied at boot.
DATABASE_PATH=./data/dev.sqlite

# Key for the anonymous analytics guest key (HMAC-SHA256).
# DEV ONLY. NEVER use this value in production: production needs its own random secret,
# kept in the password manager and never changed (it would break returning-guest analytics).
GUEST_KEY_SECRET=dev-only-not-for-production-0b7f3c9a

# Mail. Optional in development: outside production mail always goes to the local sink,
# even if these are set. All of them are required when NODE_ENV=production.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
