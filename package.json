{
	"name": "sauna-booking",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"engines": {
		"node": "26.13.0"
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"i18n:types": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy cookie preferredLanguage baseLocale --emit-ts-declarations --silent",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n:types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n:types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run i18n:types && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"db:generate": "drizzle-kit generate"
	},
	"dependencies": {
		"better-sqlite3": "13.0.3",
		"drizzle-orm": "0.45.4",
		"valibot": "1.5.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@inlang/paraglide-js": "2.29.3",
		"@sveltejs/adapter-node": "6.0.1",
		"@sveltejs/kit": "3.1.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@types/better-sqlite3": "9.6.0",
		"@types/node": "26.6.6",
		"drizzle-kit": "0.31.11",
		"eslint": "10.14.0",
		"eslint-plugin-svelte": "3.24.1",
		"globals": "17.14.0",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.2",
		"vite": "8.3.6",
		"vitest": "4.1.12"
	}
}
